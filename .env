# Flask Application Configuration
FLASK_ENV=production
APP_PORT=3000
DEBUG_MODE=False
APP_VERSION=4.0.0

# MySQL Database Configuration
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=smartchatbox
MYSQL_USER=root #chatbox
MYSQL_PASSWORD=smartchatbox
MYSQL_DATABASE=THA6

# Ollama LLM Configuration
OLLAMA_HOST=http://localhost:11434

# ChromaDB Configuration
CHROMADB_HOST=chromadb
CHROMADB_PORT=8000

# Application Features
ENABLE_DOCUMENT_CHAT=1
ENABLE_SMART_CHAT=1

# Python Configuration
PYTHONUNBUFFERED=1
